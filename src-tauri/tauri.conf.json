{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteAsk",
  "version": "0.2.5",
  "identifier": "com.liteask.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "toolbar",
        "title": "LiteAsk Toolbar",
        "url": "index.html#/toolbar",
        "width": 208,
        "height": 44,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "action",
        "title": "LiteAsk Result",
        "url": "index.html#/action",
        "width": 440,
        "height": 380,
        "minWidth": 340,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "quick-ask",
        "title": "LiteAsk Quick Ask",
        "url": "index.html#/quick-ask",
        "width": 640,
        "height": 500,
        "minWidth": 480,
        "minHeight": 160,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "LiteAsk 设置",
        "url": "index.html#/settings",
        "width": 580,
        "height": 640,
        "minWidth": 520,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERjhGRTNFNkUxNDBBMzgKUldRNENoUnVQdjc0M2RSZFZEbzlRRnA3TVg5YkJQTm05NGhqN3JtWUs0S0xRMVRIcmFDbllEVkgK",
      "endpoints": [
        "https://github.com/kylinpoet/LiteAsk/releases/latest/download/latest.json"
      ]
    }
  }
}
